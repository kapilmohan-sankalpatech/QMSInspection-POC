FROM runpod/pytorch:2.4.0-py3.11-cuda12.4.1-devel-ubuntu22.04

WORKDIR /app

COPY requirements-serverless.txt .
RUN pip install --no-cache-dir -r requirements-serverless.txt

COPY handler.py .

# Put the trained model at models/best.pt when building the image,
# or replace this with a model download step from object storage.
COPY models/ ./models/

ENV MODEL_PATH=/app/models/best.pt
ENV CONFIDENCE=0.35
ENV IMAGE_SIZE=640

CMD ["python", "-u", "handler.py"]
